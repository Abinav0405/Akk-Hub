# AKK Hub — copy to `.env` and fill in. Restart `npm run dev` after edits.
# All VITE_* values are bundled into the browser: public config only, never service_role keys.
#
# Interim setup: three Supabase projects, one client each (src/core/supabase.js).
# Later these collapse into the single new AKK Hub project.

# Timesheet Manager project (also used for the hub sign-in)
VITE_TIMESHEET_SUPABASE_URL=
VITE_TIMESHEET_SUPABASE_ANON_KEY=

# Material Tracker project
VITE_MATERIALS_SUPABASE_URL=
VITE_MATERIALS_SUPABASE_ANON_KEY=

# Site Progress Tracker project (shared with AKK Camera)
VITE_PROGRESS_SUPABASE_URL=
VITE_PROGRESS_SUPABASE_ANON_KEY=

# Timesheet admin: optional comma-separated admin email allowlist (defence in depth)
VITE_ADMIN_EMAIL_ALLOWLIST=
# Timesheet admin delete PIN (UX friction only, not a secret)
VITE_ADMIN_DELETE_PIN=
# Push registration (optional)
VITE_PUSH_REGISTER_SECRET=
VITE_ENABLE_FCM_REGISTER=false
