{
  "appId": "sg.akk.hub",
  "appName": "AKK Hub",
  "webDir": "dist",
  "backgroundColor": "#4a0b1d",
  "server": {
    "cleartext": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "sound",
        "alert"
      ]
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": false,
      "launchFadeOutDuration": 0,
      "backgroundColor": "#4a0b1d",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": false
    }
  }
}
