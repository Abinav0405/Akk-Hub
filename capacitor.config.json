{
  "appId": "sg.akk.hub",
  "appName": "AKK Hub",
  "webDir": "dist",
  "backgroundColor": "#0f172a",
  "server": {
    "cleartext": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["sound", "alert"]
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": false,
      "launchFadeOutDuration": 0,
      "backgroundColor": "#0f172a",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": false
    }
  }
}
