# Copy this file to  migration/.env.migration.local  and fill it in. That file is gitignored.
# NEVER paste these values into chat. The migration scripts read them from this file only.
#
# Where to find a connection string:
#   Supabase dashboard → the project → Connect (top bar) → "Session pooler" → copy the URI,
#   then replace [YOUR-PASSWORD] with that project's database password.
#   (Use the Session pooler, not "Direct connection": direct is IPv6-only and often fails on home/office networks.)
#
# The three SOURCE projects are only ever READ from. The NEW project is the only one written to.

SRC_ATTENDANCE_DB_URL=
SRC_MATERIALS_DB_URL=
SRC_PROGRESS_DB_URL=

NEW_DB_URL=

# Needed only for the photo/file copy (step 4). Dashboard → Project Settings → API → "service_role" key.
# Server-side secrets: they bypass all security rules. Keep them in this file only.
SRC_ATTENDANCE_URL=https://xuqvzlbfqdkfjjhdvzac.supabase.co
SRC_ATTENDANCE_SERVICE_KEY=
SRC_MATERIALS_URL=https://tglslbsruyzkqpxczdzn.supabase.co
# Only needed if Materials has storage buckets (the tool tells you).
SRC_MATERIALS_SERVICE_KEY=
SRC_PROGRESS_URL=https://qpndkdbomtbnhkdyigyy.supabase.co
SRC_PROGRESS_SERVICE_KEY=
NEW_URL=https://rvejqoxmvcemeebywpzx.supabase.co
NEW_SERVICE_KEY=
