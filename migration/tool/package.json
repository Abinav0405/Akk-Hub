    "storage": "node migrate.mjs storage",
    "selftest": "node selftest.mjs"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "pg-copy-streams": "^6.0.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10"
  }
}
